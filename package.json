{
  "name": "salutant",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Email sign-in proofs: a code to your inbox, a signed proof to the app. Phase 1 is local and mocked, with no real sends, no credentials and no network calls.",
  "engines": {
    "node": "26.13.0"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/*.js' --test-coverage-include-all --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 tests/*.test.js",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:all": "node scripts/check-types.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
