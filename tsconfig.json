{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "strict": true,
    "types": ["node"],
    "strictNullChecks": true,
    "lib": [
      "es2022",
      "dom",
      "webworker.importscripts",
      "scripthost",
      "dom.iterable",
      "dom.asynciterable",
      "es2024.promise"
    ]
  },
  "include": [
    "src/**/*.js",
    "scripts/**/*.js",
    "tests/measurement/v8merge.mjs"
  ],
  "exclude": ["node_modules"]
}
